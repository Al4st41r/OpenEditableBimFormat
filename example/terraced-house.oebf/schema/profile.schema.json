{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "oebf://schema/0.1/profile",
  "title": "OEBF Profile",
  "type": "object",
  "required": ["$schema", "id", "type", "svg_file", "origin", "alignment", "assembly"],
  "additionalProperties": false,
  "definitions": {
    "pen_mm": {
      "description": "Line weight in millimetres at print scale. Limited to the pen series so drawings plot predictably and map onto DXF lineweights.",
      "type": "number",
      "enum": [0.09, 0.13, 0.18, 0.25, 0.35, 0.5, 0.7]
    }
  },
  "properties": {
    "$schema":     { "type": "string" },
    "id":          { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type":        { "type": "string", "const": "Profile" },
    "description": { "type": "string" },
    "svg_file":    { "type": "string" },
    "width":       { "type": "number", "exclusiveMinimum": 0 },
    "height":      { "type": ["number", "null"] },
    "origin": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "alignment": {
      "type": "string",
      "enum": ["center", "left-face", "right-face", "top-face", "bottom-face"]
    },
    "detail":   { "type": "boolean" },
    "profile_type": {
      "type": "string",
      "enum": ["wall", "slab"]
    },
    "ffl_m": {
      "type": "number",
      "minimum": 0
    },
    "height_limit_m": {
      "type": "number",
      "minimum": 0
    },
    "lineweights": {
      "type": "object",
      "description": "Pen weight for each drawing role, in millimetres at print scale. Omitted roles use the defaults: cut 0.35, seen 0.18, hatch 0.09, annotation 0.09. When cut is omitted, drawings may use a weight by layer function (structure 0.5, finish 0.35, insulation 0.25, service 0.25, membrane 0.18).",
      "additionalProperties": false,
      "properties": {
        "cut":        { "$ref": "#/definitions/pen_mm" },
        "seen":       { "$ref": "#/definitions/pen_mm" },
        "hatch":      { "$ref": "#/definitions/pen_mm" },
        "annotation": { "$ref": "#/definitions/pen_mm" }
      }
    },
    "assembly": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "name", "material_id", "function"],
        "properties": {
          "layer":       { "type": "integer", "minimum": 1 },
          "name":        { "type": "string" },
          "material_id": { "type": "string" },
          "thickness":   { "type": "number", "exclusiveMinimum": 0 },
          "function":    { "type": "string", "enum": ["finish", "structure", "insulation", "membrane", "service"] },
          "outline_mm":  { "$ref": "#/definitions/pen_mm", "description": "Overrides the profile's cut weight for this layer's outline." },
          "type": {
            "type": "string",
            "enum": ["band", "region"]
          },
          "vertices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            }
          },
          "depth_m":    { "type": "number", "exclusiveMinimum": 0 },
          "repeat_x_m": { "type": "number", "exclusiveMinimum": 0 },
          "repeat_y_m": { "type": "number", "exclusiveMinimum": 0 },
          "offset_x_m": { "type": "number" },
          "offset_y_m": { "type": "number" }
        }
      }
    }
  }
}

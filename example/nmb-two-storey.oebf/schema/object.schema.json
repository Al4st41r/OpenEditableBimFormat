{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "oebf://schema/0.1/object",
  "title": "OEBF Object (Symbol Instance)",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "type",
    "symbol_id",
    "host_element_id",
    "path_id",
    "path_position",
    "parent_group_id"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "const": "Object"
    },
    "description": {
      "type": "string"
    },
    "ifc_type": {
      "type": "string"
    },
    "symbol_id": {
      "type": "string"
    },
    "host_element_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "path_position": {
      "type": "number"
    },
    "opening_id": {
      "type": "string"
    },
    "parameter_overrides": {
      "type": "object"
    },
    "parent_group_id": {
      "type": "string"
    },
    "properties": {
      "type": "object"
    },
    "base_height_m": {
      "type": "number",
      "default": 0,
      "description": "Height of the object's base above the host path, metres. Ignored when the object is in an opening (it then rests on the sill)."
    },
    "array": {
      "type": "object",
      "additionalProperties": false,
      "description": "Repeat the object in a grid: count_along instances spaced spacing_along_m along the wall, in count_up rows spaced spacing_up_m, the first at the object's position. Wall ties at 900 mm along and 450 mm up are count_along 20, spacing_along_m 0.9, count_up 6, spacing_up_m 0.45.",
      "properties": {
        "count_along": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 1
        },
        "spacing_along_m": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "count_up": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 1
        },
        "spacing_up_m": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      }
    }
  }
}
